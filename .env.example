# Niveshak AI - Environment Variables
# Copy this file to .env and configure as needed.

# Cache Database Path (SQLite)
DB_PATH=data/cache.db

# Debug Mode
DEBUG=false

# Optional: LLM Narrative Generation (Rewrites deterministic metrics into beginner-friendly explanations)
# If left empty, Niveshak AI seamlessly falls back to high-quality templated plain-English explanations.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini

# Optional: Frontend static file serving from FastAPI
SERVE_FRONTEND=false
